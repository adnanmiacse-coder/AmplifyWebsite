{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/ai/(.*)",
      "dest": "/backend/api.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(career|experiments|chemistry|biology-lab|classroom|classroomai|deeplearn|amplify-tutor|dashboard|routine|quiz|einstein)",
      "dest": "/$1.html"
    },
    {
      "src": "/teacher/(.*)",
      "dest": "/teacher/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
